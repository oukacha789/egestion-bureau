{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "egestion",
  "version": "0.1.1-beta",
  "identifier": "com.mellouki.egestion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "eGestion",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5OUNEMTYyQTg3RjQ1RTQKUldUa1JYK29ZdEdjK1lncGpnd1N0WVNESlNRS1FmUUZtaFFHZjQ2UFR5eDJmUUgxMTN5M25mMVYK",
      "endpoints": [
        "https://github.com/oukacha789/egestion-bureau/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
